# ==============================================================================
# 灵·洞本体工作站 V3 — 自定义大模型与环境配置模板
# 复制或直接编辑同目录下的 .env 文件（或直接在前端「模型、权限与运行」页面在线配置）
# ==============================================================================

# 1. OpenAI 兼容大模型接口（支持阿里云百炼 Qwen、DeepSeek、本地 vLLM / Ollama、OpenAI）
# 留空 OPENAI_API_KEY 时，系统自动使用内置 Oxigraph 确定性语义规划器离线运行
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-max
OPENAI_API_KEY=

# 2. 服务监听端口与可选 ELK 严格推理边车
PORT=8280
# ELK_SIDECAR_URL=http://127.0.0.1:8281

# 3. 生产网关零信任令牌（本地开发留空即可；生产环境开启后强制校验证书/网关签名）
# PLATFORM_GATEWAY_TOKEN=replace-with-strong-gateway-secret
