# Multi-stage production Dockerfile for Lingdong Ontology Studio API (Node 24 Alpine)
FROM node:24-alpine AS builder
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/
COPY packages/semantic-core/package.json packages/semantic-core/
COPY packages/cli/package.json packages/cli/
COPY apps/api/package.json apps/api/

RUN pnpm install --frozen-lockfile --filter @lingdong/api...

COPY packages/ packages/
COPY apps/api/ apps/api/

RUN pnpm --filter @lingdong/contracts build \
  && pnpm --filter @lingdong/semantic-core build \
  && pnpm --filter @lingdong/api build

FROM node:24-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8280

COPY --from=builder /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/contracts/package.json ./packages/contracts/
COPY --from=builder /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=builder /app/packages/semantic-core/package.json ./packages/semantic-core/
COPY --from=builder /app/packages/semantic-core/dist ./packages/semantic-core/dist
COPY --from=builder /app/packages/semantic-core/node_modules ./packages/semantic-core/node_modules
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules

RUN mkdir -p /app/apps/api/.data && chown -R node:node /app
USER node

EXPOSE 8280
HEALTHCHECK --interval=15s --timeout=4s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8280/health || exit 1

CMD ["node", "apps/api/dist/server.js"]
